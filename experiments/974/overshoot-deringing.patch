+/// Experiment #974 variant, not shipped: mozjpeg's overshoot deringing (`preprocess_deringing` in
+/// its `jcdctmgr.c`). A decoder clamps reconstructed samples to 255 (§A.3.1 inverse level shift
+/// and clamp), so a run of saturated samples codes equally well as any value at or above the
+/// ceiling. Each zig-zag-order run of level-shifted 127s becomes a Catmull-Rom bump through the
+/// ceiling whose end slopes follow the run's neighbours, capped at
+/// `127 + min(31, 2·dc_step, (127·64 − Σ samples) / run samples)`, which lets the transform spend
+/// less on the ringing a hard edge into the ceiling produces. Blocks with no saturated sample, or
+/// only saturated samples, are untouched. Applied to every component, as mozjpeg does.
+fn overshoot_deringing(block: &mut [i32; 64], dc_step: u8) {
+    const MAX: i32 = 255 - 128;
+    let sum: i32 = block.iter().sum();
+    let count = block.iter().filter(|&&s| s >= MAX).count() as i32;
+    if count == 0 || count == 64 {
+        return;
+    }
+    let max_overshoot = MAX + 31.min(2 * i32::from(dc_step)).min((MAX * 64 - sum) / count);
+    let at = |b: &[i32; 64], k: usize| b[ZIGZAG[k]];
+    let mut n = 0usize;
+    while n < 64 {
+        if at(block, n) < MAX {
+            n += 1;
+            continue;
+        }
+        // A run of saturated samples: `start` is its first position, `end` the first past it.
+        let start = n;
+        n += 1;
+        while n < 64 && at(block, n) >= MAX {
+            n += 1;
+        }
+        let end = n;
+        let f1 = at(block, start.saturating_sub(1));
+        let f2 = at(block, start.saturating_sub(2));
+        let l1 = at(block, end.min(63));
+        let l2 = at(block, if end < 62 { end + 1 } else { 63 });
+        let mut fslope = (f1 - f2).max(MAX - f1);
+        let mut lslope = (l1 - l2).max(MAX - l1);
+        // A run touching either end of the block has no slope there: make the bump symmetric.
+        if start == 0 {
+            fslope = lslope;
+        }
+        if end == 64 {
+            lslope = fslope;
+        }
+        let length = (end - start) as i32;
+        let step = 1.0 / (length + 1) as f32;
+        let mut position = step;
+        for k in start..end {
+            let v = catmull_rom(MAX - fslope, MAX, MAX, MAX - lslope, position, length);
+            block[ZIGZAG[k]] = (v.ceil() as i32).min(max_overshoot);
+            position += step;
+        }
+        n += 1;
+    }
+}
