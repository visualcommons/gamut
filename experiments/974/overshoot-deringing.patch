+/// The Catmull-Rom (cubic Hermite) segment from `v2` to `v3` at `t ∈ [0, 1]`, its tangents taken
+/// from `v1` and `v4` and scaled by `size`, as mozjpeg's deringing evaluates it.
+fn catmull_rom(v1: i32, v2: i32, v3: i32, v4: i32, t: f32, size: i32) -> f32 {
+    let tan1 = ((v3 - v1) * size) as f32;
+    let tan2 = ((v4 - v2) * size) as f32;
+    let (t2, t3) = (t * t, t * t * t);
+    let f1 = 2.0 * t3 - 3.0 * t2 + 1.0;
+    let f2 = -2.0 * t3 + 3.0 * t2;
+    let f3 = t3 - 2.0 * t2 + t;
+    let f4 = t3 - t2;
+    v2 as f32 * f1 + tan1 * f3 + v3 as f32 * f2 + tan2 * f4
+}
